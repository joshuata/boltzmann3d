<?xml version="1.0" encoding="UTF-8"?>
<project name="Boltzmann 3D" default="dist" basedir=".">
    <property name="src" location="src"/>
    <property name="bin" location="bin"/>
    <property name="dist" location="dist"/>
    <property name="deps" location="build/deps"/>
    <property name="test.bin" location="build/test-classes"/>
    <property name="java.release" value="25"/>
    <!-- Match the LWJGL version used to build lwjgl3-awt 0.2.5. -->
    <property name="lwjgl.version" value="3.4.2"/>
    <property name="lwjgl.awt.version" value="0.2.5"/>
    <!-- Select LWJGL's JDK 25 backend instead of legacy sun.misc.Unsafe. -->
    <property name="lwjgl.internal.package" value="java.base/jdk.internal.misc"/>
    <property name="lwjgl.jdk.options" value="--add-exports=${lwjgl.internal.package}=ALL-UNNAMED"/>
    <property name="maven.repo" value="https://repo.maven.apache.org/maven2"/>
    <property name="main.class" value="edu.byu.chem.boltzmann.fullapplication.Main"/>
    <!-- Keep the generated Swing forms and layout library for this first port. -->
    <property name="swing.jar" location="lib/swing-layout-1.0.4.jar"/>

    <path id="compile.classpath">
        <pathelement location="${swing.jar}"/>
        <fileset dir="${deps}" includes="lwjgl-${lwjgl.version}.jar,lwjgl-opengl-${lwjgl.version}.jar,lwjgl-jawt-${lwjgl.version}.jar,lwjgl-egl-${lwjgl.version}.jar,lwjgl3-awt-${lwjgl.awt.version}.jar" erroronmissingdir="false"/>
    </path>
    <path id="runtime.classpath">
        <path refid="compile.classpath"/>
        <pathelement location="${bin}"/>
        <fileset dir="${deps}" includes="lwjgl-${lwjgl.version}-natives-*.jar,lwjgl-opengl-${lwjgl.version}-natives-*.jar" erroronmissingdir="false"/>
    </path>

    <target name="init">
        <mkdir dir="${bin}"/>
        <mkdir dir="${dist}"/>
        <mkdir dir="${deps}"/>
    </target>

    <target name="deps" depends="init" description="Fetch pinned LWJGL 3 and Swing AWT surface libraries">
        <get src="${maven.repo}/org/lwjgl/lwjgl/${lwjgl.version}/lwjgl-${lwjgl.version}.jar"
             dest="${deps}/lwjgl-${lwjgl.version}.jar" skipexisting="true"/>
        <get src="${maven.repo}/org/lwjgl/lwjgl-opengl/${lwjgl.version}/lwjgl-opengl-${lwjgl.version}.jar"
             dest="${deps}/lwjgl-opengl-${lwjgl.version}.jar" skipexisting="true"/>
        <get src="${maven.repo}/org/lwjgl/lwjgl-jawt/${lwjgl.version}/lwjgl-jawt-${lwjgl.version}.jar"
             dest="${deps}/lwjgl-jawt-${lwjgl.version}.jar" skipexisting="true"/>
        <get src="${maven.repo}/org/lwjgl/lwjgl-egl/${lwjgl.version}/lwjgl-egl-${lwjgl.version}.jar"
             dest="${deps}/lwjgl-egl-${lwjgl.version}.jar" skipexisting="true"/>
        <get src="${maven.repo}/org/lwjglx/lwjgl3-awt/${lwjgl.awt.version}/lwjgl3-awt-${lwjgl.awt.version}.jar"
             dest="${deps}/lwjgl3-awt-${lwjgl.awt.version}.jar" skipexisting="true"/>
    </target>

    <target name="platform">
        <condition property="native.classifier" value="natives-macos-arm64">
            <and><os family="mac"/><or><os arch="aarch64"/><os arch="arm64"/></or></and>
        </condition>
        <condition property="native.classifier" value="natives-windows">
            <and><os family="windows"/><or><os arch="amd64"/><os arch="x86_64"/></or></and>
        </condition>
        <fail unless="native.classifier"
              message="Native builds require an ARM64 JDK on Apple Silicon macOS or an x64 JDK on Windows 10/11. Detected ${os.name}/${os.arch}."/>
    </target>

    <target name="native-deps" depends="deps,platform" description="Fetch natives for the current target">
        <get src="${maven.repo}/org/lwjgl/lwjgl/${lwjgl.version}/lwjgl-${lwjgl.version}-${native.classifier}.jar"
             dest="${deps}/lwjgl-${lwjgl.version}-${native.classifier}.jar" skipexisting="true"/>
        <get src="${maven.repo}/org/lwjgl/lwjgl-opengl/${lwjgl.version}/lwjgl-opengl-${lwjgl.version}-${native.classifier}.jar"
             dest="${deps}/lwjgl-opengl-${lwjgl.version}-${native.classifier}.jar" skipexisting="true"/>
    </target>

    <target name="compile" depends="deps" description="Compile the desktop app with Java 25">
        <!-- Prevent obsolete JOGL output from being carried into the runnable JAR. -->
        <delete dir="${bin}/edu/byu/chem/boltzmann/view/render/jogl"/>
        <!-- Remove class files from the retired compatibility renderer. -->
        <delete>
            <fileset dir="${bin}/edu/byu/chem/boltzmann/view/render/lwjgl"
                     includes="LwjglRenderer*.class" erroronmissingdir="false"/>
        </delete>
        <!-- Remove the former generated Swing form's retired GLPanel class. -->
        <delete file="${bin}/edu/byu/chem/boltzmann/view/maingui/components/GLPanel.class"/>
        <!-- These obsolete applets and pressure classes were already excluded. -->
        <javac srcdir="${src}" destdir="${bin}" release="${java.release}"
               encoding="UTF-8" debug="true" includeantruntime="false"
               classpathref="compile.classpath"
               excludes="edu/byu/chem/boltzmann/model/statistics/WallPressure.java,edu/byu/chem/boltzmann/model/statistics/VirialPressure.java,edu/byu/chem/boltzmann/modules/idealgas*/**"/>
        <copy todir="${bin}"><fileset dir="${src}" excludes="**/*.form,**/*.java"/></copy>
    </target>

    <target name="test" depends="compile" description="Check settings and physics without a display">
        <!-- Force a complete test compilation instead of reusing stale classes. -->
        <delete dir="${test.bin}"/>
        <mkdir dir="${test.bin}"/>
        <javac srcdir="tests" destdir="${test.bin}" release="${java.release}"
               encoding="UTF-8" includeantruntime="false" classpathref="runtime.classpath"/>
        <java classname="edu.byu.chem.boltzmann.tests.ModernizationSmokeTest" fork="true" failonerror="true">
            <classpath><path refid="runtime.classpath"/><pathelement location="${test.bin}"/></classpath>
            <jvmarg value="-Djava.awt.headless=true"/>
            <assertions><enable/></assertions>
        </java>
        <java classname="edu.byu.chem.boltzmann.tests.ParticleControlsSmokeTest" fork="true" failonerror="true">
            <classpath><path refid="runtime.classpath"/><pathelement location="${test.bin}"/></classpath>
            <jvmarg value="-Djava.awt.headless=true"/>
        </java>
        <java classname="edu.byu.chem.boltzmann.tests.PresetSmokeTest" fork="true" failonerror="true" timeout="60000">
            <classpath><path refid="runtime.classpath"/><pathelement location="${test.bin}"/></classpath>
            <jvmarg value="-Djava.awt.headless=true"/>
        </java>
        <java classname="edu.byu.chem.boltzmann.controller.ThreadLifecycleSmokeTest" fork="true" failonerror="true" timeout="60000">
            <classpath><path refid="runtime.classpath"/><pathelement location="${test.bin}"/></classpath>
            <jvmarg value="-Djava.awt.headless=true"/>
        </java>
    </target>

    <!-- boltzmann4d (TypeScript port) tools: parity fixtures and physics benchmarks. -->
    <property name="tools.bin" location="build/tools"/>
    <property name="presets.dir" location="src/edu/byu/chem/boltzmann/resources/simsettingsfiles/presets"/>
    <!-- Settings the bundled presets don't exercise (e.g. a conducting divider). -->
    <property name="scenarios.dir" location="tests/edu/byu/chem/boltzmann/tools/scenarios"/>

    <target name="tools-compile" depends="compile">
        <delete dir="${tools.bin}"/>
        <mkdir dir="${tools.bin}"/>
        <javac srcdir="tests" destdir="${tools.bin}" release="${java.release}" encoding="UTF-8"
               includeantruntime="false" classpathref="runtime.classpath"
               includes="edu/byu/chem/boltzmann/tools/**"/>
    </target>

    <target name="parity-dump" depends="tools-compile"
            description="Write boltzmann4d parity fixtures: ant parity-dump -Dparity.out=DIR [-Dparity.events=2000]">
        <fail unless="parity.out" message="Set -Dparity.out to the output directory"/>
        <property name="parity.events" value="2000"/>
        <java classname="edu.byu.chem.boltzmann.tools.ParityDump" fork="true" failonerror="true">
            <classpath><path refid="runtime.classpath"/><pathelement location="${tools.bin}"/></classpath>
            <jvmarg value="-Djava.awt.headless=true"/>
            <!-- Lets ParityDump seed Math.random() so fixtures are reproducible. -->
            <jvmarg value="--add-opens=java.base/java.lang=ALL-UNNAMED"/>
            <arg value="${parity.out}"/>
            <arg value="${parity.events}"/>
            <arg value="${presets.dir}/default.set"/>
            <arg value="${presets.dir}/2Dbrownian.set"/>
            <arg value="${presets.dir}/2Ddiffuse.set"/>
            <arg value="${presets.dir}/2Deffuse.set"/>
            <arg value="${presets.dir}/2Dentropy.set"/>
            <arg value="${presets.dir}/2Dequal.set"/>
            <arg value="${presets.dir}/2Dequil.set"/>
            <arg value="${presets.dir}/2Dhotcold.set"/>
            <arg value="${presets.dir}/2Dhyd100.set"/>
            <arg value="${presets.dir}/2Dhyd1000.set"/>
            <arg value="${presets.dir}/2Dliquid.set"/>
            <arg value="${presets.dir}/2Dmixture.set"/>
            <arg value="${presets.dir}/2Doxy100.set"/>
            <arg value="${presets.dir}/2Doxy1000.set"/>
            <arg value="${presets.dir}/2Dpresnum.set"/>
            <arg value="${scenarios.dir}/2Dhotcold-conducting.set"/>
            <arg value="${presets.dir}/3Dbrownian.set"/>
            <arg value="${presets.dir}/3Ddiffuse.set"/>
            <arg value="${presets.dir}/3Deffuse.set"/>
            <arg value="${presets.dir}/3Dentropy.set"/>
            <arg value="${presets.dir}/3Dequil.set"/>
            <arg value="${presets.dir}/3Dhotcold.set"/>
            <arg value="${presets.dir}/3Dhyd100.set"/>
            <arg value="${presets.dir}/3Dhyd1000.set"/>
            <arg value="${presets.dir}/3Dmixture.set"/>
            <arg value="${presets.dir}/3Doxy100.set"/>
            <arg value="${presets.dir}/3Doxy1000.set"/>
            <arg value="${presets.dir}/3Dpresnum.set"/>
            <arg value="${scenarios.dir}/2Dpiston-adiabatic.set"/>
            <arg value="${scenarios.dir}/2Dpiston-isothermal.set"/>
            <arg value="${scenarios.dir}/2Dwells.set"/>
            <arg value="${scenarios.dir}/2Dwells-mixture.set"/>
        </java>
    </target>

    <target name="benchmark" depends="tools-compile"
            description="Physics scaling benchmark for boltzmann4d: ant benchmark -Dbenchmark.out=FILE [-Dbenchmark.counts=...]">
        <fail unless="benchmark.out" message="Set -Dbenchmark.out to the output JSON file"/>
        <property name="benchmark.warmup" value="2"/>
        <property name="benchmark.measure" value="5"/>
        <property name="benchmark.maxframe" value="30"/>
        <property name="benchmark.counts" value="100 300 1000 3000 10000 20000"/>
        <property name="benchmark.heap" value="12g"/>
        <java classname="edu.byu.chem.boltzmann.tools.PhysicsBenchmark" fork="true" failonerror="true">
            <classpath><path refid="runtime.classpath"/><pathelement location="${tools.bin}"/></classpath>
            <jvmarg value="-Djava.awt.headless=true"/>
            <jvmarg value="-Xmx${benchmark.heap}"/>
            <arg value="${benchmark.out}"/>
            <arg value="${benchmark.warmup}"/>
            <arg value="${benchmark.measure}"/>
            <arg value="${benchmark.maxframe}"/>
            <arg line="${benchmark.counts}"/>
        </java>
    </target>

    <target name="test-render" depends="test-render-core"
            description="Alias for the core-profile rendering check"/>

    <target name="test-render-core" depends="test,native-deps" description="Check core-profile rendering (requires a display)">
        <java classname="edu.byu.chem.boltzmann.tests.RenderingSmokeTest" fork="true" failonerror="true" timeout="60000">
            <classpath><path refid="runtime.classpath"/><pathelement location="${test.bin}"/></classpath>
            <jvmarg value="--enable-native-access=ALL-UNNAMED"/>
            <jvmarg value="${lwjgl.jdk.options}"/>
            <jvmarg value="--add-exports=java.desktop/sun.awt=ALL-UNNAMED"/>
            <jvmarg value="--add-exports=java.desktop/sun.java2d=ALL-UNNAMED"/>
            <assertions><enable/></assertions>
        </java>
    </target>

    <target name="run" depends="compile,native-deps" description="Run the Swing app with LWJGL 3">
        <java classname="${main.class}" fork="true" failonerror="true" classpathref="runtime.classpath">
            <jvmarg value="--enable-native-access=ALL-UNNAMED"/>
            <jvmarg value="${lwjgl.jdk.options}"/>
            <jvmarg value="--add-exports=java.desktop/sun.awt=ALL-UNNAMED"/>
            <jvmarg value="--add-exports=java.desktop/sun.java2d=ALL-UNNAMED"/>
            <assertions><enable/></assertions>
        </java>
    </target>

    <target name="jar" depends="compile,native-deps" description="Build a runnable JAR and runtime libraries">
        <delete dir="${dist}/lib"/>
        <mkdir dir="${dist}/lib"/>
        <copy file="${swing.jar}" todir="${dist}/lib"/>
        <copy todir="${dist}/lib">
            <fileset dir="${deps}" includes="lwjgl-${lwjgl.version}.jar,lwjgl-opengl-${lwjgl.version}.jar,lwjgl-jawt-${lwjgl.version}.jar,lwjgl-egl-${lwjgl.version}.jar,lwjgl3-awt-${lwjgl.awt.version}.jar,lwjgl-${lwjgl.version}-${native.classifier}.jar,lwjgl-opengl-${lwjgl.version}-${native.classifier}.jar"/>
        </copy>
        <manifestclasspath property="manifest.classpath" jarfile="${dist}/Boltzmann3D.jar">
            <classpath><fileset dir="${dist}/lib" includes="*.jar"/></classpath>
        </manifestclasspath>
        <jar destfile="${dist}/Boltzmann3D.jar" basedir="${bin}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
                <attribute name="Class-Path" value="${manifest.classpath}"/>
                <attribute name="Enable-Native-Access" value="ALL-UNNAMED"/>
                <attribute name="Add-Exports" value="java.desktop/sun.awt java.desktop/sun.java2d ${lwjgl.internal.package}"/>
            </manifest>
        </jar>
        <copy file="LICENSE" todir="${dist}"/>
        <copy todir="${dist}/presets">
            <fileset dir="${src}/edu/byu/chem/boltzmann/resources/simsettingsfiles/presets"/>
        </copy>
    </target>
    <target name="dist" depends="jar" description="Build the distribution for this platform"/>

    <import file="packaging.xml"/>

    <target name="clean" description="Remove compiled output; keep downloaded dependencies">
        <delete dir="${bin}"/>
        <delete dir="${dist}"/>
        <delete dir="${test.bin}"/>
    </target>
</project>
